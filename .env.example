# ── Required ────────────────────────────────────────────────
APP_URL=http://localhost:3000
DATABASE_URL=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/shrunk?sslmode=require
BETTER_AUTH_SECRET=            # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=          # redirect URI: $APP_URL/api/auth/callback/google
RESEND_API_KEY=
EMAIL_FROM="Shrunk <noreply@your-domain>"
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
DATA_ENCRYPTION_KEY=           # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shrunk-eu            # create with EU jurisdiction
INNGEST_EVENT_KEY=             # prod only
INNGEST_SIGNING_KEY=           # prod only

# ── Optional connectors (missing = connector hidden, never faked) ──
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
DROPBOX_APP_KEY=

# ── J2: analysis ────────────────────────────────────────────
ANTHROPIC_API_KEY=
WORKER_URL=https://<workspace>--shrunk-worker-api.modal.run
WORKER_TOKEN=                  # 32+ random chars, same value in the Modal secret
WORKER_CALLBACK_SECRET=        # 32+ random chars, same value as CALLBACK_SECRET in the Modal secret

# ── J4: publishing (missing = platform hidden). Callbacks: <APP_URL>/api/social/<platform>/callback ──
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_AUDITED=0               # 1 only after TikTok's audit: direct post instead of inbox drafts
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_DAILY_UPLOADS=100      # "Video Uploads" quota of the Google Cloud project
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── E2E local tooling (optional, otherwise ffprobe is taken from PATH) ──
# FFPROBE_PATH=C:\path\to\ffprobe.exe
# YouTube stays disabled unless explicitly requested: pnpm e2e --publish-youtube=<social account UUID>
