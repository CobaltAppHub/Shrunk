# ── Required ────────────────────────────────────────────────
APP_URL=http://localhost:3000
DATABASE_URL=postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/shrunk?sslmode=require
BETTER_AUTH_SECRET=            # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=          # redirect URI: $APP_URL/api/auth/callback/google
RESEND_API_KEY=
EMAIL_FROM="Shrunk <noreply@your-domain>"
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
DATA_ENCRYPTION_KEY=           # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shrunk-eu            # create with EU jurisdiction
INNGEST_EVENT_KEY=             # prod only
INNGEST_SIGNING_KEY=           # prod only

